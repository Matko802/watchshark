<?xml version="1.0" encoding="utf-8"?>
<!-- Bottom scrim over full-bleed reels: dark at the very bottom so the
     nav pill zone and captions stay readable, fading to clear upward so
     the wheel shows through behind. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="#CC000000"
        android:endColor="#00000000" />
</shape>
