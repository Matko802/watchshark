<?xml version="1.0" encoding="utf-8"?>
<!-- Transparent variant of the bottom nav pill for full-bleed wheels:
     the wheel shows through, with just a whisper of black plus the
     standard outline so the buttons stay readable. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners android:radius="32dp" />
    <solid android:color="#33000000" />
    <stroke
        android:width="1dp"
        android:color="#3D3D3D" />
</shape>
