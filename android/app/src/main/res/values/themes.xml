<resources>
    <style name="Theme.WatchShark" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <!-- Monochrome AMOLED: no Material purple anywhere. -->
        <item name="colorPrimary">@android:color/white</item>
        <item name="colorOnPrimary">@android:color/black</item>
        <item name="colorPrimaryContainer">#222222</item>
        <item name="colorOnPrimaryContainer">@android:color/white</item>
        <item name="colorSecondary">#A8A8A8</item>
        <item name="colorOnSecondary">@android:color/black</item>
        <item name="colorTertiary">#DDDDDD</item>
        <item name="colorSurface">@android:color/black</item>
        <item name="colorOnSurface">@android:color/white</item>
        <item name="colorSurfaceVariant">#141414</item>
        <item name="colorOnSurfaceVariant">#A8A8A8</item>
        <item name="colorError">@android:color/white</item>
        <item name="android:colorError">@android:color/white</item>
    </style>

    <style name="Theme.WatchShark.Splash" parent="Theme.WatchShark">
        <item name="android:windowBackground">@drawable/splash</item>
    </style>

    <style name="ShapeAppearance.WatchShark.Rounded12" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">12dp</item>
    </style>
</resources>
